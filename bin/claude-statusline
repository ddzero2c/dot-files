#!/usr/bin/env bash
input=$(cat)
now=$(date +%s)

# Model-scoped weekly limits (e.g. Fable) are not in the statusline payload,
# and Claude Code's own cache in ~/.claude.json goes stale for days, so fetch
# /api/oauth/usage ourselves. Cached locally with a 5-minute TTL and refreshed
# in the background so rendering never blocks on the network.
usage_cache="$HOME/.cache/claude-statusline-usage.json"
if [ $(( now - $(stat -f %m "$usage_cache" 2>/dev/null || echo 0) )) -gt 300 ]; then
  (
    token=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null \
              | jq -r '.claudeAiOauth.accessToken // empty')
    [ -n "$token" ] || exit 0
    mkdir -p "${usage_cache%/*}"
    out=$(curl -sf --max-time 5 "https://api.anthropic.com/api/oauth/usage" \
            -H "Authorization: Bearer $token" -H "anthropic-beta: oauth-2025-04-20")
    [ -n "$out" ] && printf '%s' "$out" > "$usage_cache"
  ) >/dev/null 2>&1 &
fi
[ -f "$usage_cache" ] && usage_src="$usage_cache" || usage_src=/dev/null

# Pull every field in one jq pass; read line-by-line to preserve empty fields.
_i=0
while IFS= read -r _line; do
  _f[_i++]="$_line"
done < <(jq -r --slurpfile usage "$usage_src" '
    (.model.display_name // "" | sub(" \\(1M context\\)$"; "")) as $model |
    .cwd // .workspace.current_dir // "",
    $model,
    (.context_window.used_percentage // ""),
    (.rate_limits.five_hour.used_percentage // ""),
    (.rate_limits.five_hour.resets_at // ""),
    (.rate_limits.seven_day.used_percentage // ""),
    (.rate_limits.seven_day.resets_at // ""),
    ([first($usage[0].limits[]?
            | select(.kind == "weekly_scoped")
            | (.scope.model.display_name // "") as $n
            | select($n != "" and ($model | startswith($n))))][0]
     | if . == null then "" else
         "\(.percent)\t\(try (.resets_at | sub("(\\.[0-9]+)?(\\+00:00)?$"; "Z") | fromdateiso8601) catch 0)"
       end)
  ' <<< "$input")
cwd="${_f[0]}" model="${_f[1]}" used_pct="${_f[2]}"
five_pct="${_f[3]}" five_reset="${_f[4]}"
week_pct="${_f[5]}" week_reset="${_f[6]}"

# When the active model has its own weekly bucket, show that as the weekly
# usage — unless the cached window already reset (cache too stale to trust).
IFS=$'\t' read -r scoped_pct scoped_reset <<< "${_f[7]}"
if [ -n "$scoped_pct" ] && [ "$scoped_reset" -gt "$now" ]; then
  week_pct="$scoped_pct" week_reset="$scoped_reset"
fi

# Format path: strip leading $HOME, show path relative to home
display_path="${cwd/#$HOME\//}"
[ "$cwd" = "$HOME" ] && display_path="~"

# ANSI colors (real escape chars via $'...' so we can embed in %s args)
GREY=$'\e[90m'
RESET=$'\e[0m'
PATH_C=$'\e[1m\e[34m'   # bold blue
MODEL_C=$'\e[36m'       # cyan
SEP_C=$'\e[90m'         # grey separators / emoji / remaining time
# Colorblind-friendly: cyan / yellow / red. Avoid pairing red with green elsewhere.
LOW=$'\e[96m'    # bright cyan
MID=$'\e[93m'    # bright yellow
HIGH=$'\e[91m'   # bright red

# Rate-limit tier color: <50 grey, 50-69 cyan, 70-89 yellow, >=90 red.
color_for_pct() {
  local v=${1%.*}
  if   [ "$v" -ge 90 ]; then printf '%s' "$HIGH"
  elif [ "$v" -ge 70 ]; then printf '%s' "$MID"
  elif [ "$v" -ge 50 ]; then printf '%s' "$LOW"
  else                       printf '%s' "$GREY"
  fi
}

# Context tier color: thresholds 20/50/80, sharing the rate-limit palette.
# Below 20% stays grey to avoid noise on fresh sessions.
ctx_color_for_pct() {
  local v=${1%.*}
  if   [ "$v" -ge 80 ]; then printf '%s' "$HIGH"
  elif [ "$v" -ge 50 ]; then printf '%s' "$MID"
  elif [ "$v" -ge 20 ]; then printf '%s' "$LOW"
  else                       printf '%s' "$GREY"
  fi
}

ctx_info=""
if [ -n "$used_pct" ]; then
  c=$(ctx_color_for_pct "$used_pct")
  pct=${used_pct%.*}
  width=10
  filled=$(( (pct * width + 50) / 100 ))
  [ "$filled" -gt "$width" ] && filled=$width
  bar=""
  for ((i = 0; i < width; i++)); do
    if [ "$i" -lt "$filled" ]; then bar+="█"; else bar+="░"; fi
  done
  ctx_info=$(printf "%s%s%s" "$c" "$bar" "$GREY")
fi

fmt_remain() {
  local secs=$1
  [ "$secs" -le 0 ] && { printf "0m"; return; }
  local d=$((secs / 86400)) h=$(((secs % 86400) / 3600)) m=$(((secs % 3600) / 60))
  if   [ "$d" -gt 0 ]; then printf "%dd%dh%dm" "$d" "$h" "$m"
  elif [ "$h" -gt 0 ]; then printf "%dh%dm" "$h" "$m"
  else                      printf "%dm" "$m"
  fi
}

# Rate limit usage (Claude.ai subscription)
rate_info=""
if [ -n "$five_pct" ] || [ -n "$week_pct" ]; then
  rate_parts=""
  if [ -n "$five_pct" ]; then
    c=$(color_for_pct "$five_pct")
    remain=""
    [ -n "$five_reset" ] && remain=" $(fmt_remain $((${five_reset%.*} - now)))"
    rate_parts=$(printf "${SEP_C}⏰ %s%.0f%%%s%s" "$c" "$five_pct" "$GREY" "$remain")
  fi
  if [ -n "$week_pct" ]; then
    c=$(color_for_pct "$week_pct")
    week_remain=""
    [ -n "$week_reset" ] && week_remain=" $(fmt_remain $((${week_reset%.*} - now)))"
    week_part=$(printf "${SEP_C}📅 %s%.0f%%%s%s" "$c" "$week_pct" "$GREY" "$week_remain")
    [ -n "$rate_parts" ] && rate_parts="$rate_parts | $week_part" || rate_parts="$week_part"
  fi
  rate_info="$rate_parts"
fi

SEP=" ${SEP_C}| "
info="${MODEL_C}${model}${GREY}"
[ -n "$ctx_info" ] && info="${info}${SEP}${ctx_info}"
[ -n "$rate_info" ] && info="${info}${SEP}${rate_info}"

printf "%s%s%s%s%s%s" \
  "$PATH_C" "$display_path" "$RESET" \
  "$SEP" "$info" "$RESET"
