{
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/repo/dot-files/claude/mods/sessions-view"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "fable[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/bin/claude-statusline"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "code-modernization@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "claude-tmux-notifier@ddzero2c": true,
    "gopls-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "ios-simulator-skill@conorluddy": true
  },
  "extraKnownMarketplaces": {
    "ddzero2c": {
      "source": {
        "source": "github",
        "repo": "ddzero2c/claude-tmux-notifier"
      }
    },
    "conorluddy": {
      "source": {
        "source": "github",
        "repo": "conorluddy/ios-simulator-skill"
      }
    }
  },
  "outputStyle": "adhd",
  "syntaxHighlightingDisabled": false,
  "effortLevel": "low",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "low"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "verbose": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
