{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "ctrl+k": "abovePrompt:focus"
      }
    },
    {
      "context": "Pane",
      "bindings": {
        "ctrl+k": "abovePrompt:leave",
        "up": "abovePrompt:previous",
        "down": "abovePrompt:next"
      }
    }
  ]
}
